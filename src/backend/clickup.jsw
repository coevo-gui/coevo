export async function getTarefasCliente(siglas) {
  const token = await getSecret('CLICKUP_TOKEN');
  const now   = Date.now();
  const dueGt = now - 10 * MS_DIA;
  const dueLt = now + 15 * MS_DIA;

  const customFields = [
    { field_id: FIELD_VIS, operator: '=', value: '1' },
  ];

  if (siglas !== null && siglas.length > 0) {
    const optionIds = siglas
      .map(s => SIGLAS[s.toUpperCase()]?.id)
      .filter(Boolean);
    if (optionIds.length > 0) {
      customFields.push({ field_id: FIELD_CLI, operator: 'ANY', value: optionIds });
    }
  }

  const url =
    `https://api.clickup.com/api/v2/team/${TEAM_ID}/task` +
    `?project_ids[]=${FOLDER_ID}` +
    `&include_closed=true` +
    `&due_date_gt=${dueGt}` +
    `&due_date_lt=${dueLt}` +
    `&custom_fields=${encodeURIComponent(JSON.stringify(customFields))}` +
    `&order_by=due_date` +
    `&reverse=false` +
    `&page=0`;

  const res = await fetch(url, { headers: { Authorization: token } });

  if (!res.ok) {
    const body = await res.text();
    console.error('ClickUp API error:', res.status, body);
    throw new Error(`ClickUp API ${res.status}`);
  }

  const { tasks = [] } = await res.json();
  return _normalize(tasks, now);
}

function _normalize(tasks, now) {
  return tasks
    .map(t => {
      const prazo    = t.due_date ? Number(t.due_date) : null;
      const diasDiff = prazo !== null ? Math.round((prazo - now) / MS_DIA) : null;
      const concluida = t.status?.type === 'closed';
      const atrasada  = !concluida && diasDiff !== null && diasDiff < 0;

      const clienteF   = (t.custom_fields || []).find(f => f.id === FIELD_CLI);
      const siglaRaw   = clienteF?.value?.[0]?.label || '';
      const sigla      = siglaRaw.toUpperCase();
      const siglaColor = SIGLAS[sigla]?.color || '#6b7280';

      const assignee    = t.assignees?.[0];
      const responsavel = assignee ? (assignee.username || assignee.email || '—') : '—';

      // status normalizado sem acentos — usado no filtro "em aprovação" client-side
      const statusNorm = (t.status?.status || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

      return {
        _id:             t.id,
        nome:            t.name || '',
        status:          t.status?.status || '',
        statusColor:     t.status?.color || '#9ca3af',
        statusNorm,
        prazo,
        prazoFormatado:  prazo
          ? new Date(prazo).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })
          : '—',
        lista:           t.list?.name || '',
        responsavel,
        descricao:       (t.description || '').slice(0, 180).trim(),
        url:             t.url || '#',
        atrasada,
        diasAtraso:      atrasada ? Math.abs(diasDiff) : 0,
        diasFaltam:      (!atrasada && !concluida && diasDiff !== null) ? diasDiff : 0,
        sigla,
        siglaColor,
        concluida,
        // ponto roxo: atualizado nas últimas 48h
        recenteAtividade: t.date_updated ? (now - Number(t.date_updated)) < 2 * MS_DIA : false,
      };
    })
    .sort((a, b) => {
      if (a.atrasada  !== b.atrasada)  return a.atrasada  ? -1 : 1;
      if (a.concluida !== b.concluida) return a.concluida ?  1 : -1;
      return (a.prazo || 0) - (b.prazo || 0);
    });
}
