// Web Method — Disparos de Cobrança
// IMPORTANTE: campos REFERENCE (disparoRef, subclienteRef) só são salvos corretamente
// no backend com suppressAuth: true. No frontend, wixData.insert/update silenciosamente
// descarta campos de referência. Por isso CREATE_DISPARO e SALVAR_RASCUNHO são backend.
//
// ATENÇÃO (aprendizado): wixData.query em .jsw pode NÃO retornar campos REFERENCE
// nos itens resultantes (subclienteRef volta null). Por isso enviarDisparos recebe
// itemScMap da página, que já tem os IDs do estado local (via _sc._id).

import { getSecret } from 'wix-secrets-backend';
import wixData from 'wix-data';

const BREVO_URL = 'https://api.brevo.com/v3/smtp/email';
const REMETENTE = { name: 'Mídia Coevo', email: 'midia@coevo.co' };

function parseBRL(str) {
  if (!str) return 0;
  return parseFloat(
    String(str).replace('R$', '').replace(/\./g, '').replace(',', '.').trim()
  ) || 0;
}

// ─── Criar disparo + itens no backend (necessário para salvar campos REFERENCE) ─
export async function criarDisparoComItens(payload) {
  try {
    const { titulo, plataforma, mesReferencia, dataVencimento, textoCorpo, subclienteIds, criadoPor } = payload;

    const novoDisparo = await wixData.insert('disparos', {
      titulo, plataforma,
      mesReferencia: mesReferencia || null,
      dataVencimento: dataVencimento || null,
      textoCorpo: textoCorpo || '',
      status: 'rascunho',
      criadoPor: criadoPor || '',
      totalEnviados: 0
    }, { suppressAuth: true });

    const scResult = await wixData.query('subclientes').hasSome('_id', subclienteIds).find({ suppressAuth: true });
    const scMap = {};
    scResult.items.forEach(sc => { scMap[sc._id] = sc; });

    const itens = await Promise.all(subclienteIds.map(scId => {
      const sc = scMap[scId] || {};
      const valor = plataforma === 'mads' ? parseBRL(sc.valorMidiaMeta) : parseBRL(sc.valorMidiaGoogle);
      return wixData.insert('itensDisparo', {
        disparoRef: novoDisparo._id,
        subclienteRef: scId,
        valorInvestimento: valor || 0,
        tipoPagamento: 'boleto',
        pixCode: '',
        boletoUrl: '',
        statusEnvio: 'pendente'
      }, { suppressAuth: true });
    }));

    return {
      ok: true,
      disparoId: novoDisparo._id,
      disparo: novoDisparo,
      // FIX: usar subclienteIds[i] em vez de item.subclienteRef (que pode vir null do insert)
      itens: itens.map((item, i) => ({ ...item, _sc: scMap[subclienteIds[i]] || {} }))
    };
  } catch (err) {
    console.error('[emailDisparo] criarDisparoComItens erro:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Buscar itens de um disparo no backend ────────────────────────────────────
export async function fetchItensDisparo(disparoId) {
  try {
    const [disparo, itensResult] = await Promise.all([
      wixData.get('disparos', disparoId, { suppressAuth: true }),
      wixData.query('itensDisparo').eq('disparoRef', disparoId).find({ suppressAuth: true })
    ]);
    const itens = itensResult.items;
    const scIds = [...new Set(itens.map(i => i.subclienteRef).filter(Boolean))];
    const scResult = scIds.length
      ? await wixData.query('subclientes').hasSome('_id', scIds).find({ suppressAuth: true })
      : { items: [] };
    const scMap = {};
    scResult.items.forEach(sc => { scMap[sc._id] = sc; });
    return {
      ok: true,
      disparo,
      itens: itens.map(item => ({ ...item, _sc: scMap[item.subclienteRef] || {} }))
    };
  } catch (err) {
    console.error('[emailDisparo] fetchItensDisparo erro:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Salvar rascunho (atualizar campos editáveis preservando referências) ─────
export async function salvarRascunhoItens(itens) {
  try {
    await Promise.all(itens.map(async (item) => {
      const existing = await wixData.get('itensDisparo', item._id, { suppressAuth: true });
      return wixData.update('itensDisparo', {
        ...existing,
        valorInvestimento: item.valorInvestimento,
        tipoPagamento: item.tipoPagamento,
        pixCode: item.pixCode || '',
        boletoUrl: item.boletoUrl || ''
      }, { suppressAuth: true });
    }));
    return { ok: true };
  } catch (err) {
    console.error('[emailDisparo] salvarRascunhoItens erro:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Enviar emails de cobrança ────────────────────────────────────────────────
function buildAssunto(disparo, sc) {
  const dataRef = disparo.mesReferencia
    ? new Date(disparo.mesReferencia).toLocaleDateString('pt-BR')
    : new Date().toLocaleDateString('pt-BR');
  const plat = { gads: 'Google Ads', mads: 'Meta Ads', ambas: 'Google Ads e Meta Ads' }[disparo.plataforma] || disparo.plataforma || '';
  return `COEVO | Cobrança ${plat} | ${sc.sigla} | ${sc.nome} | Cobrança - ref. ${dataRef}`;
}

function buildHtml(disparo, item, sc) {
  const valor = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.valorInvestimento || 0);
  const venc = disparo.dataVencimento ? new Date(disparo.dataVencimento).toLocaleDateString('pt-BR') : '—';
  const platUpper = { gads: 'GOOGLE ADS', mads: 'META ADS', ambas: 'GOOGLE ADS e META ADS' }[disparo.plataforma] || (disparo.plataforma || '').toUpperCase();
  const blocoPagamento = item.tipoPagamento === 'pix'
    ? `<p style="margin:0 0 8px 0"><strong>CÓDIGO PIX:</strong></p>
       <div style="background:#f5f7ff;border:1px solid #ccd4ff;border-radius:6px;padding:12px;
                   font-family:monospace;font-size:12px;word-break:break-all;color:#002bff;line-height:1.5">
         ${item.pixCode || ''}
       </div>`
    : `<p style="margin:0 0 8px 0"><strong>LINK DO BOLETO:</strong></p>
       <p style="margin:0">
         <a href="${item.boletoUrl || '#'}" style="color:#002bff;font-weight:600">
           ${sc.sigla} - ${sc.nome} - Download do Boleto
         </a>
       </p>`;
  return `<!DOCTYPE html>
<html lang="pt-BR">
<body style="font-family:Arial,sans-serif;font-size:14px;color:#333333;max-width:600px;margin:0 auto;padding:24px;line-height:1.6">
  <p>Bom dia,</p>
  <p>Prezado(a) Parceiro COEVO,</p>
  <p>${disparo.textoCorpo || `Estamos enviando este email com o boleto para pagamento do saldo da sua conta <strong>${platUpper}</strong>.`}</p>
  <div style="background:#f9f9ff;border-left:4px solid #002bff;border-radius:6px;padding:16px 20px;margin:20px 0">
    <p style="margin:0 0 10px 0"><strong>Sobre a cobrança:</strong></p>
    <p style="margin:0 0 4px 0">Hotel: ${sc.nome}</p>
    <p style="margin:0 0 4px 0">CNPJ: ${sc.cnpj || '—'}</p>
    <p style="margin:0 0 4px 0">Valor: <strong>${valor}</strong></p>
    <p style="margin:0"><strong>Pagar até: ${venc}</strong></p>
  </div>
  <div style="margin:20px 0">${blocoPagamento}</div>
  <p><em>Por favor, é importante que seja pago dentro do período informado, para evitar que a conta fique sem saldo.</em></p>
  <p>É isso! Obrigado pela sua atenção! ;)</p>
  <p>Equipe <a href="https://coevo.co" style="color:#002bff">coevo.co</a></p>
</body>
</html>`;
}

// itemScMap: { [itemId]: scId } — passado pela página para evitar depender de
// wixData.query retornar campos REFERENCE (comportamento inconsistente no Velo)
export async function enviarDisparos(disparoId, itemScMap = {}) {
  try {
    const brevoKey = await getSecret('BREVO_API_KEY');
    if (!brevoKey) return { ok: false, error: 'BREVO_API_KEY vazia no Secrets Manager' };
    const headers = { 'Content-Type': 'application/json', 'api-key': brevoKey };

    const disparo = await wixData.get('disparos', disparoId, { suppressAuth: true });
    if (!disparo) return { ok: false, error: 'Disparo não encontrado: ' + disparoId };

    const itensResult = await wixData
      .query('itensDisparo')
      .eq('disparoRef', disparoId)
      .find({ suppressAuth: true });
    const itens = itensResult.items;
    if (!itens.length) return { ok: false, error: 'Nenhum item para: ' + disparoId };

    // Coleta scIds: prioriza itemScMap (estado local da página), fallback para subclienteRef da query
    const scIds = [...new Set(
      itens.map(item => itemScMap[item._id] || item.subclienteRef)
    )].filter(Boolean);

    // Usa wixData.get individual (mais confiável que hasSome para campos REFERENCE)
    const scArr = scIds.length
      ? await Promise.all(scIds.map(scId =>
          wixData.get('subclientes', scId, { suppressAuth: true }).catch(() => null)
        ))
      : [];
    const scMap = {};
    scArr.forEach(sc => { if (sc && sc._id) scMap[sc._id] = sc; });

    // Diagnóstico — retornado no result para debug via painel HTML
    const _debug = {
      itemScMap_keys: Object.keys(itemScMap).length,
      scIds,
      scMap_keys: Object.keys(scMap).length,
      first_subclienteRef: itens[0] ? itens[0].subclienteRef : 'no items'
    };

    let enviados = 0;
    let erros = 0;

    for (const item of itens) {
      const scId = itemScMap[item._id] || item.subclienteRef;
      const sc = scMap[scId];
      if (!sc || !sc.emailFinanceiro) {
        console.warn('[emailDisparo] sem emailFinanceiro. scId:', scId, 'sc encontrado:', !!sc);
        erros++;
        const ei = await wixData.get('itensDisparo', item._id, { suppressAuth: true });
        await wixData.update('itensDisparo', { ...ei, statusEnvio: 'erro' }, { suppressAuth: true });
        continue;
      }

      // FIX: emailsCopia pode usar espaço ou vírgula como separador
      const ccList = (sc.emailsCopia || '').split(/[,\s]+/).map(e => e.trim()).filter(Boolean).map(email => ({ email }));
      const emailPayload = {
        sender: REMETENTE,
        to: [{ email: sc.emailFinanceiro, name: sc.contatoFinanceiro || sc.nome }],
        cc: ccList,
        subject: buildAssunto(disparo, sc),
        htmlContent: buildHtml(disparo, item, sc)
      };

      try {
        const res = await fetch(BREVO_URL, { method: 'POST', headers, body: JSON.stringify(emailPayload) });
        const ei = await wixData.get('itensDisparo', item._id, { suppressAuth: true });
        if (res.ok) {
          enviados++;
          await wixData.update('itensDisparo', { ...ei, statusEnvio: 'enviado', emailEnviadoPara: sc.emailFinanceiro }, { suppressAuth: true });
        } else {
          const errText = await res.text();
          console.error(`[emailDisparo] Brevo [${sc.sigla}] ${res.status}:`, errText);
          erros++;
          await wixData.update('itensDisparo', { ...ei, statusEnvio: 'erro' }, { suppressAuth: true });
        }
      } catch (fetchErr) {
        console.error(`[emailDisparo] fetch error [${sc.sigla}]:`, fetchErr.message);
        erros++;
      }
    }

    const ed = await wixData.get('disparos', disparoId, { suppressAuth: true });
    const statusFinal = erros === 0 ? 'enviado' : erros === itens.length ? 'erro' : 'parcial';
    await wixData.update('disparos', { ...ed, status: statusFinal, totalEnviados: enviados }, { suppressAuth: true });

    return { ok: erros === 0, enviados, erros, total: itens.length, _debug };

  } catch (err) {
    console.error('[emailDisparo] erro:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}
