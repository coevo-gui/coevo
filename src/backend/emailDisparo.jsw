// Web Method — Disparos de Cobrança
// APRENDIZADO: wixData.query em .jsw pode NÃO retornar campos REFERENCE
// nos itens resultantes (subclienteRef volta null). Por isso enviarDisparos recebe
// itemScMap da página, que já tem os IDs do estado local (via _sc._id).

import { getSecret } from 'wix-secrets-backend';
import wixData from 'wix-data';

const BREVO_URL = 'https://api.brevo.com/v3/smtp/email';
const REMETENTE = { name: 'Mídia Coevo', email: 'midia@coevo.co' };
// Logo para fundo branco (300x93px)
const LOGO_URL = 'https://static.wixstatic.com/media/9653d9_9568c16de9094b8f933964c0cefedaa2~mv2.png';

function parseBRL(str) {
  if (!str) return 0;
  return parseFloat(
    String(str).replace('R$', '').replace(/\./g, '').replace(',', '.').trim()
  ) || 0;
}

function isValidEmail(e) {
  return e && typeof e === 'string' && e.includes('@') && e !== 'N/A';
}

// Resolve a lista de destinatários (to + cc) de um subcliente conforme as escolhas
function resolverDestinatarios(sc, destinatarios = {}) {
  const dest = {
    financeiro:   destinatarios.financeiro   !== false,
    gerenteGeral: destinatarios.gerenteGeral !== false,
    focalMkt:     destinatarios.focalMkt     !== false,
    copia:        destinatarios.copia        !== false
  };
  const to = [];
  if (dest.financeiro   && isValidEmail(sc.emailFinanceiro))   to.push({ email: sc.emailFinanceiro,  name: sc.contatoFinanceiro || sc.nome });
  if (dest.gerenteGeral && isValidEmail(sc.emailGerenteGeral)) to.push({ email: sc.emailGerenteGeral, name: sc.nome });
  if (dest.focalMkt     && isValidEmail(sc.focalMktEmail))     to.push({ email: sc.focalMktEmail,    name: sc.nome });

  const cc = [];
  if (dest.copia && sc.emailsCopia) {
    sc.emailsCopia.split(/[,\s]+/).map(e => e.trim()).filter(isValidEmail).forEach(email => {
      if (!to.some(t => t.email === email)) cc.push({ email });
    });
  }
  return { to, cc };
}

// ─── Listar disparos + contagem de itens (coluna Hotéis) ──────────
export async function fetchDisparos() {
  try {
    const result = await wixData.query('disparos').descending('_createdDate').limit(1000).find({ suppressAuth: true });
    const disparos = result.items;
    const counts = await Promise.all(disparos.map(d =>
      wixData.query('itensDisparo').eq('disparoRef', d._id).count({ suppressAuth: true }).catch(() => 0)
    ));
    return { ok: true, data: disparos.map((d, i) => ({ ...d, _totalItens: counts[i] })) };
  } catch (err) {
    console.error('[emailDisparo] fetchDisparos:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Criar disparo + itens no backend ────────────────────────────────
export async function criarDisparoComItens(payload) {
  try {
    const { titulo, plataforma, mesReferencia, dataVencimento, textoCorpo, subclienteIds, criadoPor } = payload;

    const novoDisparo = await wixData.insert('disparos', {
      titulo, plataforma,
      mesReferencia: mesReferencia || null,
      dataVencimento: dataVencimento || null,
      textoCorpo: textoCorpo || '',
      status: 'rascunho',
      criadoPor: criadoPor || '',
      totalEnviados: 0
    }, { suppressAuth: true });

    const scResult = await wixData.query('subclientes').hasSome('_id', subclienteIds).limit(1000).find({ suppressAuth: true });
    const scMap = {};
    scResult.items.forEach(sc => { scMap[sc._id] = sc; });

    const itens = await Promise.all(subclienteIds.map(scId => {
      const sc = scMap[scId] || {};
      const valor = plataforma === 'mads' ? parseBRL(sc.valorMidiaMeta) : parseBRL(sc.valorMidiaGoogle);
      return wixData.insert('itensDisparo', {
        disparoRef: novoDisparo._id,
        subclienteRef: scId,
        valorInvestimento: valor || 0,
        tipoPagamento: 'boleto',
        pixCode: '',
        boletoUrl: '',
        statusEnvio: 'pendente'
      }, { suppressAuth: true });
    }));

    return {
      ok: true,
      disparoId: novoDisparo._id,
      disparo: novoDisparo,
      itens: itens.map((item, i) => ({ ...item, _sc: scMap[subclienteIds[i]] || {} }))
    };
  } catch (err) {
    console.error('[emailDisparo] criarDisparoComItens:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Buscar itens de um disparo ────────────────────────────────────
export async function fetchItensDisparo(disparoId) {
  try {
    const [disparo, itensResult] = await Promise.all([
      wixData.get('disparos', disparoId, { suppressAuth: true }),
      wixData.query('itensDisparo').eq('disparoRef', disparoId).limit(1000).find({ suppressAuth: true })
    ]);
    const itens = itensResult.items;
    const scIds = [...new Set(itens.map(i => i.subclienteRef).filter(Boolean))];
    const scResult = scIds.length
      ? await wixData.query('subclientes').hasSome('_id', scIds).limit(1000).find({ suppressAuth: true })
      : { items: [] };
    const scMap = {};
    scResult.items.forEach(sc => { scMap[sc._id] = sc; });
    return {
      ok: true,
      disparo,
      itens: itens.map(item => ({ ...item, _sc: scMap[item.subclienteRef] || {} }))
    };
  } catch (err) {
    console.error('[emailDisparo] fetchItensDisparo:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Salvar rascunho ────────────────────────────────────────────────
export async function salvarRascunhoItens(itens) {
  try {
    await Promise.all(itens.map(async (item) => {
      const existing = await wixData.get('itensDisparo', item._id, { suppressAuth: true });
      return wixData.update('itensDisparo', {
        ...existing,
        valorInvestimento: item.valorInvestimento,
        tipoPagamento: item.tipoPagamento,
        pixCode: item.pixCode || '',
        boletoUrl: item.boletoUrl || ''
      }, { suppressAuth: true });
    }));
    return { ok: true };
  } catch (err) {
    console.error('[emailDisparo] salvarRascunhoItens:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Deletar disparo e todos os seus itens ──────────────────────────
export async function deletarDisparo(disparoId) {
  try {
    const itensResult = await wixData
      .query('itensDisparo')
      .eq('disparoRef', disparoId)
      .limit(1000)
      .find({ suppressAuth: true });

    await Promise.all(
      itensResult.items.map(item =>
        wixData.remove('itensDisparo', item._id, { suppressAuth: true })
      )
    );

    await wixData.remove('disparos', disparoId, { suppressAuth: true });
    return { ok: true };
  } catch (err) {
    console.error('[emailDisparo] deletarDisparo:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Helpers de email ────────────────────────────────────────────────
function buildAssunto(disparo, sc) {
  const dataRef = disparo.mesReferencia
    ? new Date(disparo.mesReferencia).toLocaleDateString('pt-BR')
    : new Date().toLocaleDateString('pt-BR');
  const plat = { gads: 'Google Ads', mads: 'Meta Ads', ambas: 'Google Ads e Meta Ads' }[disparo.plataforma] || disparo.plataforma || '';
  return `COEVO | Cobrança ${plat} | ${sc.sigla} | ${sc.nome} | Cobrança - ref. ${dataRef}`;
}

function buildHtml(disparo, item, sc) {
  const valor = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.valorInvestimento || 0);
  const venc  = disparo.dataVencimento ? new Date(disparo.dataVencimento).toLocaleDateString('pt-BR') : '\u2014';
  const platUpper = { gads: 'GOOGLE ADS', mads: 'META ADS', ambas: 'GOOGLE ADS e META ADS' }[disparo.plataforma] || (disparo.plataforma || '').toUpperCase();
  const textoCorpo = disparo.textoCorpo || `Estamos enviando este email com o boleto para pagamento do saldo da sua conta <strong>${platUpper}</strong>.`;

  const blocoPagamento = item.tipoPagamento === 'pix'
    ? `<p style="margin:0 0 10px;color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em">C&oacute;digo PIX:</p>
       <div style="background:#ffffff;border:1px solid #ccd4ff;border-radius:8px;padding:14px;font-family:monospace;font-size:12px;word-break:break-all;color:#002bff;line-height:1.6">${item.pixCode || ''}</div>`
    : `<p style="margin:0 0 10px;color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em">Link do Boleto:</p>
       <a href="${item.boletoUrl || '#'}" style="display:inline-block;background:#002bff;color:#ffffff;font-size:13px;font-weight:700;padding:12px 28px;border-radius:8px;text-decoration:none">Baixar Boleto &mdash; ${sc.nome}</a>`;

  return `<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
<body style="margin:0;padding:0;background:#f0f2f5;font-family:Arial,Helvetica,sans-serif">
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f0f2f5">
<tr><td align="center" style="padding:32px 16px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,43,255,0.08)">

    <!-- HEADER -->
    <tr><td style="background:#ffffff;padding:28px 32px 22px;text-align:center;border-bottom:3px solid #002bff">
      <img src="${LOGO_URL}" alt="Coevo" width="180" style="display:inline-block;max-width:180px;height:auto">
    </td></tr>

    <!-- BODY -->
    <tr><td style="padding:32px 36px 28px">
      <p style="margin:0 0 14px;color:#0a0a1a;font-size:15px;line-height:1.7">Bom dia,</p>
      <p style="margin:0 0 14px;color:#0a0a1a;font-size:15px;line-height:1.7">Prezado(a) Parceiro COEVO,</p>
      <p style="margin:0 0 28px;color:#333333;font-size:14px;line-height:1.7">${textoCorpo}</p>

      <!-- Billing info card -->
      <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f5f7ff;border-left:4px solid #002bff;border-radius:0 12px 12px 0;margin:0 0 20px">
        <tr><td style="padding:20px 24px">
          <p style="margin:0 0 12px;color:#0a0a1a;font-size:10px;font-weight:bold;letter-spacing:.08em;text-transform:uppercase">Sobre a Cobran&ccedil;a</p>
          <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td style="padding:3px 20px 3px 0;color:#6b7280;font-size:13px;white-space:nowrap">Hotel:</td>
              <td style="padding:3px 0;color:#0a0a1a;font-size:13px;font-weight:600">${sc.nome}</td>
            </tr>
            <tr>
              <td style="padding:3px 20px 3px 0;color:#6b7280;font-size:13px">CNPJ:</td>
              <td style="padding:3px 0;color:#0a0a1a;font-size:13px">${sc.cnpj || '\u2014'}</td>
            </tr>
            <tr>
              <td style="padding:3px 20px 3px 0;color:#6b7280;font-size:13px">Valor:</td>
              <td style="padding:3px 0;color:#002bff;font-size:17px;font-weight:bold">${valor}</td>
            </tr>
            <tr>
              <td style="padding:3px 20px 3px 0;color:#6b7280;font-size:13px">Vencimento:</td>
              <td style="padding:3px 0;color:#0a0a1a;font-size:14px;font-weight:700">${venc}</td>
            </tr>
          </table>
        </td></tr>
      </table>

      <!-- Payment section -->
      <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f8f9fa;border:1px solid #e5e7eb;border-radius:12px;margin:0 0 24px">
        <tr><td style="padding:20px 24px">${blocoPagamento}</td></tr>
      </table>

      <p style="margin:0 0 16px;color:#6b7280;font-size:13px;font-style:italic;line-height:1.6">
        Por favor, &eacute; importante que seja pago dentro do per&iacute;odo informado,
        para evitar que a conta fique sem saldo.
      </p>
      <p style="margin:0 0 6px;color:#0a0a1a;font-size:14px">&Eacute; isso! Obrigado pela sua aten&ccedil;&atilde;o! ;)</p>
      <p style="margin:0;color:#0a0a1a;font-size:14px">
        Equipe <a href="https://coevo.co" style="color:#002bff;font-weight:700;text-decoration:none">coevo.co</a>
      </p>
    </td></tr>

    <!-- FOOTER -->
    <tr><td style="background:#0a0a1a;padding:18px 36px;text-align:center">
      <p style="margin:0;font-size:11px;color:#6b7280;line-height:1.8">
        &copy; Coevo &middot; Marketing de Hotelaria &middot;
        <a href="https://coevo.co" style="color:#002bff;text-decoration:none;font-weight:600">coevo.co</a>
        &middot;
        <a href="mailto:midia@coevo.co" style="color:#6b7280;text-decoration:none">midia@coevo.co</a>
      </p>
    </td></tr>

  </table>
</td></tr>
</table>
</body>
</html>`;
}

// ─── Preview de um email (sem enviar) ───────────────────────────────
// itemDraft: { valorInvestimento, tipoPagamento, pixCode, boletoUrl } (valores atuais da tela)
export async function previewEmailItem(disparoId, scId, itemDraft = {}, destinatarios = {}) {
  try {
    const [disparo, sc] = await Promise.all([
      wixData.get('disparos', disparoId, { suppressAuth: true }),
      wixData.get('subclientes', scId, { suppressAuth: true })
    ]);
    if (!disparo) return { ok: false, error: 'Disparo não encontrado.' };
    if (!sc) return { ok: false, error: 'Subcliente não encontrado.' };

    const item = {
      valorInvestimento: itemDraft.valorInvestimento || 0,
      tipoPagamento: itemDraft.tipoPagamento || 'boleto',
      pixCode: itemDraft.pixCode || '',
      boletoUrl: itemDraft.boletoUrl || ''
    };
    const { to, cc } = resolverDestinatarios(sc, destinatarios);
    return {
      ok: true,
      html: buildHtml(disparo, item, sc),
      assunto: buildAssunto(disparo, sc),
      to: to.map(t => t.email),
      cc: cc.map(c => c.email)
    };
  } catch (err) {
    console.error('[emailDisparo] previewEmailItem:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Enviar email de TESTE para um endereço digitado ────────────────
// Envia APENAS para emailTeste, com prefixo [TESTE]. Não altera statusEnvio.
export async function enviarTesteItem(disparoId, scId, itemDraft = {}, emailTeste = '') {
  try {
    if (!isValidEmail(emailTeste)) return { ok: false, error: 'Email de teste inválido.' };

    const brevoKey = await getSecret('BREVO_API_KEY');
    if (!brevoKey) return { ok: false, error: 'BREVO_API_KEY vazia.' };
    const headers = { 'Content-Type': 'application/json', 'api-key': brevoKey };

    const [disparo, sc] = await Promise.all([
      wixData.get('disparos', disparoId, { suppressAuth: true }),
      wixData.get('subclientes', scId, { suppressAuth: true })
    ]);
    if (!disparo || !sc) return { ok: false, error: 'Dados não encontrados.' };

    const item = {
      valorInvestimento: itemDraft.valorInvestimento || 0,
      tipoPagamento: itemDraft.tipoPagamento || 'boleto',
      pixCode: itemDraft.pixCode || '',
      boletoUrl: itemDraft.boletoUrl || ''
    };

    const emailPayload = {
      sender: REMETENTE,
      to: [{ email: emailTeste, name: 'Teste Coevo' }],
      subject: '[TESTE] ' + buildAssunto(disparo, sc),
      htmlContent: buildHtml(disparo, item, sc)
    };

    const res = await fetch(BREVO_URL, { method: 'POST', headers, body: JSON.stringify(emailPayload) });
    if (res.ok) return { ok: true };
    const errText = await res.text();
    console.error('[emailDisparo] enviarTesteItem Brevo', res.status, errText);
    return { ok: false, error: 'Brevo ' + res.status };
  } catch (err) {
    console.error('[emailDisparo] enviarTesteItem:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}

// ─── Enviar emails (REAL) ───────────────────────────────────────────
export async function enviarDisparos(disparoId, itemScMap = {}, destinatarios = {}) {
  try {
    const brevoKey = await getSecret('BREVO_API_KEY');
    if (!brevoKey) return { ok: false, error: 'BREVO_API_KEY vazia no Secrets Manager' };
    const headers = { 'Content-Type': 'application/json', 'api-key': brevoKey };

    const disparo = await wixData.get('disparos', disparoId, { suppressAuth: true });
    if (!disparo) return { ok: false, error: 'Disparo não encontrado: ' + disparoId };

    const itensResult = await wixData
      .query('itensDisparo')
      .eq('disparoRef', disparoId)
      .limit(1000)
      .find({ suppressAuth: true });
    const itens = itensResult.items;
    if (!itens.length) return { ok: false, error: 'Nenhum item para: ' + disparoId };

    const scIds = [...new Set(
      itens.map(item => itemScMap[item._id] || item.subclienteRef)
    )].filter(Boolean);

    const scArr = scIds.length
      ? await Promise.all(scIds.map(scId =>
          wixData.get('subclientes', scId, { suppressAuth: true }).catch(() => null)
        ))
      : [];
    const scMap = {};
    scArr.forEach(sc => { if (sc && sc._id) scMap[sc._id] = sc; });

    let enviados = 0;
    let erros = 0;

    for (const item of itens) {
      const scId = itemScMap[item._id] || item.subclienteRef;
      const sc = scMap[scId];

      if (!sc) {
        console.warn('[emailDisparo] subcliente não encontrado. scId:', scId);
        erros++;
        const ei = await wixData.get('itensDisparo', item._id, { suppressAuth: true }).catch(() => null);
        if (ei) await wixData.update('itensDisparo', { ...ei, statusEnvio: 'erro' }, { suppressAuth: true });
        continue;
      }

      const { to: toEmails, cc: ccEmails } = resolverDestinatarios(sc, destinatarios);

      if (!toEmails.length) {
        console.warn('[emailDisparo] nenhum destinatário válido para:', scId);
        erros++;
        const ei = await wixData.get('itensDisparo', item._id, { suppressAuth: true }).catch(() => null);
        if (ei) await wixData.update('itensDisparo', { ...ei, statusEnvio: 'erro' }, { suppressAuth: true });
        continue;
      }

      const emailPayload = {
        sender: REMETENTE,
        to: toEmails,
        ...(ccEmails.length ? { cc: ccEmails } : {}),
        subject: buildAssunto(disparo, sc),
        htmlContent: buildHtml(disparo, item, sc)
      };

      try {
        const res = await fetch(BREVO_URL, { method: 'POST', headers, body: JSON.stringify(emailPayload) });
        const ei = await wixData.get('itensDisparo', item._id, { suppressAuth: true }).catch(() => null);
        if (res.ok) {
          enviados++;
          if (ei) await wixData.update('itensDisparo', { ...ei, statusEnvio: 'enviado', emailEnviadoPara: toEmails.map(t => t.email).join(', ') }, { suppressAuth: true });
        } else {
          const errText = await res.text();
          console.error(`[emailDisparo] Brevo [${sc.sigla}] ${res.status}:`, errText);
          erros++;
          if (ei) await wixData.update('itensDisparo', { ...ei, statusEnvio: 'erro' }, { suppressAuth: true });
        }
      } catch (fetchErr) {
        console.error(`[emailDisparo] fetch error [${sc.sigla}]:`, fetchErr.message);
        erros++;
      }
    }

    const ed = await wixData.get('disparos', disparoId, { suppressAuth: true });
    const statusFinal = erros === 0 ? 'enviado' : erros === itens.length ? 'erro' : 'parcial';
    await wixData.update('disparos', { ...ed, status: statusFinal, totalEnviados: enviados }, { suppressAuth: true });

    return { ok: erros === 0, enviados, erros, total: itens.length };

  } catch (err) {
    console.error('[emailDisparo] erro:', err.message || err);
    return { ok: false, error: err.message || String(err) };
  }
}
