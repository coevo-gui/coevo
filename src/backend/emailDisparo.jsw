// Web Method — Disparos de Cobrança
import { getSecret } from 'wix-secrets-backend';
import wixData from 'wix-data';

const BREVO_URL = 'https://api.brevo.com/v3/smtp/email';
const REMETENTE = { name: 'Mídia Coevo', email: 'midia@coevo.co' };

function formatarBRL(n) {
  return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(n || 0);
}

function buildAssunto(disparo, sc) {
  const dataRef = disparo.mesReferencia
    ? new Date(disparo.mesReferencia).toLocaleDateString('pt-BR')
    : new Date().toLocaleDateString('pt-BR');
  const plat = { gads: 'Google Ads', mads: 'Meta Ads', ambas: 'Google Ads e Meta Ads' }[disparo.plataforma] || disparo.plataforma || '';
  return `COEVO | Cobrança ${plat} | ${sc.sigla} | ${sc.nome} | Cobrança - ref. ${dataRef}`;
}

function buildHtml(disparo, item, sc) {
  const valor = formatarBRL(item.valorInvestimento);
  const venc = disparo.dataVencimento ? new Date(disparo.dataVencimento).toLocaleDateString('pt-BR') : '—';
  const platUpper = { gads: 'GOOGLE ADS', mads: 'META ADS', ambas: 'GOOGLE ADS e META ADS' }[disparo.plataforma] || (disparo.plataforma || '').toUpperCase();
  const blocoPagamento = item.tipoPagamento === 'pix'
    ? `<p style="margin:0 0 8px 0"><strong>CÓDIGO PIX:</strong></p>
       <div style="background:#f5f7ff;border:1px solid #ccd4ff;border-radius:6px;padding:12px;
                   font-family:monospace;font-size:12px;word-break:break-all;color:#002bff;line-height:1.5">
         ${item.pixCode || ''}
       </div>`
    : `<p style="margin:0 0 8px 0"><strong>LINK DO BOLETO:</strong></p>
       <p style="margin:0">
         <a href="${item.boletoUrl || '#'}" style="color:#002bff;font-weight:600">
           ${sc.sigla} - ${sc.nome} - Download do Boleto
         </a>
       </p>`;
  return `<!DOCTYPE html>
<html lang="pt-BR">
<body style="font-family:Arial,sans-serif;font-size:14px;color:#333333;max-width:600px;margin:0 auto;padding:24px;line-height:1.6">
  <p>Bom dia,</p>
  <p>Prezado(a) Parceiro COEVO,</p>
  <p>${disparo.textoCorpo || `Estamos enviando este email com o boleto para pagamento do saldo da sua conta <strong>${platUpper}</strong>.`}</p>
  <div style="background:#f9f9ff;border-left:4px solid #002bff;border-radius:6px;padding:16px 20px;margin:20px 0">
    <p style="margin:0 0 10px 0"><strong>Sobre a cobrança:</strong></p>
    <p style="margin:0 0 4px 0">Hotel: ${sc.nome}</p>
    <p style="margin:0 0 4px 0">CNPJ: ${sc.cnpj || '—'}</p>
    <p style="margin:0 0 4px 0">Valor: <strong>${valor}</strong></p>
    <p style="margin:0"><strong>Pagar até: ${venc}</strong></p>
  </div>
  <div style="margin:20px 0">${blocoPagamento}</div>
  <p><em>Por favor, é importante que seja pago dentro do período informado, para evitar que a conta fique sem saldo.</em></p>
  <p>É isso! Obrigado pela sua atenção! ;)</p>
  <p>Equipe <a href="https://coevo.co" style="color:#002bff">coevo.co</a></p>
</body>
</html>`;
}

export async function enviarDisparos(disparoId) {
  try {
    // [1] Secret
    console.log('[emailDisparo] [1] getSecret BREVO_API_KEY...');
    const brevoKey = await getSecret('BREVO_API_KEY');
    console.log('[emailDisparo] [2] brevoKey OK, length:', brevoKey ? brevoKey.length : 'null');
    const headers = { 'Content-Type': 'application/json', 'api-key': brevoKey };

    // [2] Busca disparo
    console.log('[emailDisparo] [3] wixData.get disparos id:', disparoId);
    const disparo = await wixData.get('disparos', disparoId, { suppressAuth: true });
    console.log('[emailDisparo] [4] disparo:', disparo ? disparo._id : 'null');
    if (!disparo) throw new Error('Disparo não encontrado: ' + disparoId);

    // [3] Busca itens
    console.log('[emailDisparo] [5] query itensDisparo...');
    const itensResult = await wixData
      .query('itensDisparo')
      .eq('disparoRef', disparoId)
      .find({ suppressAuth: true });
    const itens = itensResult.items;
    console.log('[emailDisparo] [6] itens.length:', itens.length);
    if (!itens.length) throw new Error('Nenhum item encontrado para: ' + disparoId);

    // [4] Busca subclientes
    const scIds = [...new Set(itens.map(i => i.subclienteRef))];
    console.log('[emailDisparo] [7] query subclientes, scIds:', scIds.length);
    const scResult = await wixData
      .query('subclientes')
      .hasSome('_id', scIds)
      .find({ suppressAuth: true });
    const scMap = {};
    scResult.items.forEach(sc => { scMap[sc._id] = sc; });
    console.log('[emailDisparo] [8] subclientes encontrados:', scResult.items.length);

    let enviados = 0;
    let erros = 0;

    for (const item of itens) {
      const sc = scMap[item.subclienteRef];
      console.log('[emailDisparo] [9] processando item:', item._id, 'sc:', sc ? sc.sigla : 'não encontrado');

      if (!sc || !sc.emailFinanceiro) {
        console.warn('[emailDisparo] [10] sem emailFinanceiro — pulando:', item.subclienteRef);
        erros++;
        await wixData.update('itensDisparo', { ...item, statusEnvio: 'erro' }, { suppressAuth: true });
        continue;
      }

      console.log('[emailDisparo] [10] emailFinanceiro:', sc.emailFinanceiro);
      const ccList = (sc.emailsCopia || '').split(',').map(e => e.trim()).filter(Boolean).map(email => ({ email }));
      const payload = {
        sender: REMETENTE,
        to: [{ email: sc.emailFinanceiro, name: sc.contatoFinanceiro || sc.nome }],
        cc: ccList,
        subject: buildAssunto(disparo, sc),
        htmlContent: buildHtml(disparo, item, sc)
      };

      try {
        console.log('[emailDisparo] [11] fetch Brevo para:', sc.sigla);
        const res = await fetch(BREVO_URL, { method: 'POST', headers, body: JSON.stringify(payload) });
        console.log('[emailDisparo] [12] Brevo status:', res.status);
        if (res.ok) {
          enviados++;
          // Fetch existing item first to preserve fields (igual briefing.jsw)
          const existingItem = await wixData.get('itensDisparo', item._id, { suppressAuth: true });
          await wixData.update('itensDisparo', {
            ...existingItem,
            statusEnvio: 'enviado',
            emailEnviadoPara: sc.emailFinanceiro
          }, { suppressAuth: true });
        } else {
          const errText = await res.text();
          console.error(`[emailDisparo] Brevo error [${sc.sigla}]: ${res.status}`, errText);
          erros++;
          const existingItem2 = await wixData.get('itensDisparo', item._id, { suppressAuth: true });
          await wixData.update('itensDisparo', { ...existingItem2, statusEnvio: 'erro' }, { suppressAuth: true });
        }
      } catch (err) {
        console.error(`[emailDisparo] Fetch error [${sc.sigla}]:`, err.message || err);
        erros++;
      }
    }

    // Atualiza status do disparo
    console.log('[emailDisparo] [13] atualizando disparo. enviados:', enviados, 'erros:', erros);
    const existingDisparo = await wixData.get('disparos', disparoId, { suppressAuth: true });
    const statusFinal = erros === 0 ? 'enviado' : erros === itens.length ? 'erro' : 'parcial';
    await wixData.update('disparos', {
      ...existingDisparo,
      status: statusFinal,
      totalEnviados: enviados
    }, { suppressAuth: true });

    console.log('[emailDisparo] [14] CONCLUÍDO. status:', statusFinal);
    return { ok: erros === 0, enviados, erros, total: itens.length };

  } catch (topErr) {
    console.error('[emailDisparo] ERRO TOP-LEVEL:', topErr.message || topErr);
    throw topErr;
  }
}
